# ISO et journaux de construction
sortie/
*.iso
build.log

# Fichiers copiés depuis branding/ et natte/ au moment de la construction
iso/config/includes.chroot/usr/share/samaos/
iso/config/includes.chroot/usr/share/plasma/plasmoids/org.samaos.*/

# Arborescence produite par live-build
iso/.build/
iso/cache/
iso/chroot/
iso/binary/
iso/config/binary
iso/config/bootstrap
iso/config/chroot
iso/config/common
iso/config/source

.DS_Store

# Mode direct (adresse locale de la machine virtuelle)
.mode-direct-adresse
iso/config/includes.chroot/usr/share/plasma/look-and-feel/org.samaos.bureau/contents/splash/ChargementSama.qml

# Identifiants de test de la machine virtuelle de développement (jamais versionnés)
.vm-identifiants
