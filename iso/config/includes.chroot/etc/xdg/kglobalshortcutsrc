# Raccourcis de Sama : Méta+Tab ouvre la vue d'ensemble des Espaces (la Natte),
# à la place du passage d'une activité à l'autre de Plasma.
[plasmashell]
next activity=none,Meta+Tab,Parcourir les activités
previous activity=none,Meta+Shift+Tab,Parcourir les activités (en sens inverse)

# Impr. : la Capture d'écran de Sama (Spectacle garde Méta+Maj+S et ses autres raccourcis)
[services][org.kde.spectacle.desktop]
_launch=Meta+Shift+S

[services][samaos-capture.desktop]
_launch=Print

# Méta+Échap et Ctrl+Maj+Échap : le Moniteur système de Sama (à la place de celui de KDE)
[services][samaos-moniteur.desktop]
_launch=Meta+Esc\tCtrl+Shift+Esc
