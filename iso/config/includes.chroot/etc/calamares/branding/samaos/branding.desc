---
componentName:   samaos
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 880px,640px
windowPlacement: center

strings:
    productName:         Sama OS
    shortProductName:    Sama
    version:             0.1
    shortVersion:        0.1
    versionedName:       Sama OS 0.1
    shortVersionedName:  Sama 0.1
    bootloaderEntryName: SamaOS
    productUrl:          https://github.com/TraoreIbrahim/sama-os
    supportUrl:          https://github.com/TraoreIbrahim/sama-os/issues
    knownIssuesUrl:      https://github.com/TraoreIbrahim/sama-os/issues
    releaseNotesUrl:     https://github.com/TraoreIbrahim/sama-os
    donateUrl:           https://github.com/TraoreIbrahim/sama-os

# En-tête (étapes) en haut et boutons en bas, dessinés en QML (calamares-sidebar.qml, calamares-navigation.qml)
sidebar: qml,top
navigation: qml,bottom

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "bienvenue.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:        "#FBF9F6"
   SidebarText:              "#665E54"
   SidebarTextCurrent:       "#1F1C18"
   SidebarBackgroundCurrent: "#B5532F"
