// Un administrateur de l'ordinateur, assis devant (session active), règle les mises à jour sans retaper
// son mot de passe ; les autres comptes passent par la fenêtre « Autorisation requise ».
polkit.addRule(function (action, subject) {
    if (action.id === "org.samaos.mises-a-jour" && subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
