[Desktop Entry]
Type=Application
Name=Sama Docs
Comment=Traitement de texte de Sama, compatible Word
Exec=sama-docs %f
Icon=/usr/share/samaos/icones/docs.svg
StartupWMClass=samaos-docs
Categories=Office;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;application/vnd.oasis.opendocument.text;application/rtf;text/rtf;
Keywords=texte;word;lettre;document;docx;odt;cv;courrier;writer;
Terminal=false
