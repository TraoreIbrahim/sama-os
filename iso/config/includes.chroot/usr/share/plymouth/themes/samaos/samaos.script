# Écran de démarrage animé de Sama OS (Plymouth, module « script »)
# Fond nuit, l'éléphant et « Sama » au centre. La trompe s'anime selon le moment :
#   démarrage            : salut (la trompe se lève puis redescend), avec une fine barre or
#   extinction/redémarrage : balancement
#   mises à jour         : la trompe se dessine en or au fil de la progression
# Les images sont calculées à la construction de l'ISO (hook 0600-sama-chargement).
# Gère aussi la saisie du mot de passe quand le disque est chiffré.

Window.SetBackgroundTopColor(0.082, 0.102, 0.169);
Window.SetBackgroundBottomColor(0.082, 0.102, 0.169);

largeur = Window.GetWidth();
hauteur = Window.GetHeight();
x0 = Window.GetX();
y0 = Window.GetY();

# --- Choix de l'animation -------------------------------------------------------
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot") {
    prefixe = "balancement-";
    nombre = 36;
    progressive = 0;
} else if (mode == "updates" || mode == "system-upgrade") {
    prefixe = "trace-";
    nombre = 41;
    progressive = 1;
} else {
    prefixe = "salut-";
    nombre = 48;
    progressive = 0;
}

# --- Images de l'éléphant (environ un tiers de la hauteur de l'écran) -------------
modele = Image(prefixe + "0.png");
logo_h = Math.Int(hauteur * 0.32);
logo_l = Math.Int(modele.GetWidth() * logo_h / modele.GetHeight());
for (i = 0; i < nombre; i++) {
    images[i] = Image(prefixe + i + ".png").Scale(logo_l, logo_h);
}

logo.sprite = Sprite(images[0]);
logo.sprite.SetPosition(x0 + largeur / 2 - logo_l / 2, y0 + hauteur * 0.44 - logo_h / 2, 1);

image_courante = 0;
tic = 0;

fun rafraichir() {
    if (progressive == 0) {
        tic++;
        if (tic >= 2) {
            tic = 0;
            image_courante++;
            if (image_courante >= nombre) image_courante = 0;
            logo.sprite.SetImage(images[image_courante]);
        }
    }
}
Plymouth.SetRefreshFunction(rafraichir);

# --- Barre de progression (démarrage seulement) -----------------------------------
barre_l = Math.Int(largeur * 0.12);
barre_h = 4;
barre_x = x0 + largeur / 2 - barre_l / 2;
barre_y = y0 + hauteur * 0.44 + logo_h / 2 + 40;

fond.sprite = Sprite(Image("barre-fond.png").Scale(barre_l, barre_h));
fond.sprite.SetPosition(barre_x, barre_y, 1);
remplissage_source = Image("barre.png");
remplissage.sprite = Sprite();
remplissage.sprite.SetPosition(barre_x, barre_y, 2);

if (progressive == 1) {
    fond.sprite.SetOpacity(0);
}

fun progression(duree, avancement) {
    if (progressive == 0) {
        l = Math.Int(barre_l * avancement);
        if (l < 1) l = 1;
        remplissage.sprite.SetImage(remplissage_source.Scale(l, barre_h));
    }
}
Plymouth.SetBootProgressFunction(progression);

# Mises à jour : la trompe se dessine en or (0 à 100 %)
fun mise_a_jour(pourcentage) {
    n = Math.Int(pourcentage * (nombre - 1) / 100);
    if (n < 0) n = 0;
    if (n > nombre - 1) n = nombre - 1;
    logo.sprite.SetImage(images[n]);
}
Plymouth.SetSystemUpdateFunction(mise_a_jour);

# --- Messages (rares) sous l'éléphant ---------------------------------------------
message.sprite = Sprite();
message.sprite.SetPosition(x0 + largeur / 2, barre_y + 28, 3);

fun afficher_message(texte) {
    image = Image.Text(texte, 0.678, 0.651, 0.596, 1);
    message.sprite.SetImage(image);
    message.sprite.SetX(x0 + largeur / 2 - image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(afficher_message);

# --- Mot de passe du disque chiffré -----------------------------------------------
invite.sprite = Sprite();
points.sprite = Sprite();

fun demander_mot_de_passe(texte, nombre_car) {
    fond.sprite.SetOpacity(0);
    remplissage.sprite.SetOpacity(0);
    titre = Image.Text("Mot de passe du disque", 0.945, 0.922, 0.882, 1);
    invite.sprite.SetImage(titre);
    invite.sprite.SetOpacity(1);
    invite.sprite.SetPosition(x0 + largeur / 2 - titre.GetWidth() / 2, barre_y - 8, 4);
    puces = "";
    for (j = 0; j < nombre_car && j < 24; j++) puces = puces + "* ";
    image = Image.Text(puces, 0.902, 0.855, 0.761, 1);
    points.sprite.SetImage(image);
    points.sprite.SetOpacity(1);
    points.sprite.SetPosition(x0 + largeur / 2 - image.GetWidth() / 2, barre_y + 28, 4);
}
Plymouth.SetDisplayPasswordFunction(demander_mot_de_passe);

fun retour_normal() {
    invite.sprite.SetOpacity(0);
    points.sprite.SetOpacity(0);
    if (progressive == 0) {
        fond.sprite.SetOpacity(1);
        remplissage.sprite.SetOpacity(1);
    }
}
Plymouth.SetDisplayNormalFunction(retour_normal);
