<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="SamaDocs" script:language="StarBasic"><![CDATA[REM Sama Docs : les styles de Sama pour un document neuf (le texte en Noto Serif 12, les titres en Noto Sans, vert
REM foncé, comme la maquette « Docs · Le document libre »), le plan (les titres du document, celui du curseur), aller à
REM un titre, et le début des documents guidés (compte rendu, lettre, CV, attestation, annonce, devoir), où « Mes
REM informations » (nom, adresse, téléphone) sont déjà écrites.
Option Explicit

Const ENCRE_TITRE = 2512454         ' RGB(38, 86, 70) : le vert de Docs, foncé
Const ENCRE_DOUCE = 6708820         ' RGB(102, 94, 84)

Private Sub ReglerStyle(oStyles As Object, sNom As String, sPolice As String, dTaille As Double, nGraisse As Double, nEncre As Long)
	Dim o As Object
	If Not oStyles.hasByName(sNom) Then Exit Sub
	o = oStyles.getByName(sNom)
	If sPolice <> "" Then o.CharFontName = sPolice
	If dTaille > 0 Then o.CharHeight = dTaille
	If nGraisse > 0 Then o.CharWeight = nGraisse
	If nEncre >= 0 Then o.CharColor = nEncre
End Sub

' Document neuf : les styles de Sama, sans le compter comme une modification
Function Preparer() As String
	Dim oDoc As Object, oStyles As Object, o As Object
	On Error GoTo Erreur
	oDoc = ThisComponent
	oStyles = oDoc.StyleFamilies.getByName("ParagraphStyles")
	ReglerStyle(oStyles, "Standard", "Noto Serif", 12, 0, -1)
	o = oStyles.getByName("Standard")
	o.ParaBottomMargin = 180
	o.ParaLineSpacing = Interligne(115)
	ReglerStyle(oStyles, "Text body", "Noto Serif", 12, 0, -1)
	ReglerStyle(oStyles, "Heading", "Noto Sans", 0, com.sun.star.awt.FontWeight.BOLD, ENCRE_TITRE)
	ReglerStyle(oStyles, "Heading 1", "Noto Sans", 14, com.sun.star.awt.FontWeight.BOLD, ENCRE_TITRE)
	ReglerStyle(oStyles, "Heading 2", "Noto Sans", 12.5, com.sun.star.awt.FontWeight.BOLD, ENCRE_TITRE)
	ReglerStyle(oStyles, "Heading 3", "Noto Sans", 11.5, com.sun.star.awt.FontWeight.BOLD, ENCRE_TITRE)
	ReglerStyle(oStyles, "Title", "Noto Serif", 22, com.sun.star.awt.FontWeight.BOLD, RGB(31, 28, 24))
	o = oStyles.getByName("Title")
	o.ParaAdjust = com.sun.star.style.ParagraphAdjust.LEFT
	ReglerStyle(oStyles, "Subtitle", "Noto Sans", 11, 0, ENCRE_DOUCE)
	o = oStyles.getByName("Subtitle")
	o.ParaAdjust = com.sun.star.style.ParagraphAdjust.LEFT
	ReglerStyle(oStyles, "Quotations", "Noto Serif", 12, 0, ENCRE_DOUCE)
	' (l'expéditeur d'une lettre : en haut à gauche, serré)
	ReglerStyle(oStyles, "Sender", "Noto Sans", 11.5, 0, -1)
	If oStyles.hasByName("Sender") Then
		o = oStyles.getByName("Sender")
		o.ParaTopMargin = 0
		o.ParaBottomMargin = 0
		o.ParaLineSpacing = Interligne(115)
	End If
	oDoc.setModified(False)
	Preparer = ""
	Exit Function
Erreur:
	Preparer = "!" & Error$
End Function

Private Function Interligne(n As Integer) As Object
	Dim l As New com.sun.star.style.LineSpacing
	l.Mode = com.sun.star.style.LineSpacingMode.PROP
	l.Height = n
	Interligne = l
End Function

' Le plan : {"titres": [{"texte", "niveau"}], "courant": rang du titre où est le curseur (-1 : avant le premier)}
Function Plan() As String
	Dim oDoc As Object, oEnum As Object, oPar As Object, oVC As Object, s As String, n As Long, nCourant As Long, nNiveau As Long
	Dim nOrdre As Integer
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	oEnum = oDoc.Text.createEnumeration()
	s = ""
	n = 0
	nCourant = -1
	Do While oEnum.hasMoreElements()
		oPar = oEnum.nextElement()
		If oPar.supportsService("com.sun.star.text.Paragraph") Then
			nNiveau = oPar.OutlineLevel
			If nNiveau > 0 And Trim(oPar.String) <> "" Then
				If s <> "" Then s = s & ","
				s = s & "{""texte"":" & Texte(Trim(oPar.String)) & ",""niveau"":" & nNiveau & "}"
				' (le titre est avant le curseur, ou à sa place : c'est la partie où l'on est)
				nOrdre = -2
				On Error Resume Next
				nOrdre = oDoc.Text.compareRegionStarts(oPar.Start, oVC.Start)
				On Error GoTo Erreur
				If nOrdre >= 0 Then nCourant = n
				n = n + 1
			End If
		End If
	Loop
	Plan = "{""titres"":[" & s & "],""courant"":" & nCourant & "}"
	Exit Function
Erreur:
	Plan = "!" & Error$
End Function

' Le curseur au début du titre de rang sRang
Function AllerAuTitre(sRang As String) As String
	Dim oDoc As Object, oEnum As Object, oPar As Object, n As Long
	On Error GoTo Erreur
	oDoc = ThisComponent
	oEnum = oDoc.Text.createEnumeration()
	n = 0
	Do While oEnum.hasMoreElements()
		oPar = oEnum.nextElement()
		If oPar.supportsService("com.sun.star.text.Paragraph") Then
			If oPar.OutlineLevel > 0 And Trim(oPar.String) <> "" Then
				If n = CLng(sRang) Then
					oDoc.CurrentController.ViewCursor.gotoRange(oPar.Start, False)
					AllerAuTitre = ""
					Exit Function
				End If
				n = n + 1
			End If
		End If
	Loop
	AllerAuTitre = "!Ce titre n'est plus dans le document"
	Exit Function
Erreur:
	AllerAuTitre = "!" & Error$
End Function

' ——— Les documents guidés : leur début, prêt à compléter ———

Private oCurseur As Object
' (la mise en page du paragraphe suivant, posée après son style : un style efface l'alignement et les retraits)
Private nAligne As Integer, nRetrait As Long, nAlinea As Long, nApres As Long, dTaille As Double, nEncre As Long

' Un paragraphe de plus, dans un style
Private Sub P(sStyle As String, sTexte As String)
	PG(sStyle, "", sTexte)
End Sub

' … qui commence par quelques mots en gras (« Objet : »)
Private Sub PG(sStyle As String, sGras As String, sTexte As String)
	Dim oText As Object
	oText = ThisComponent.Text
	oCurseur.ParaStyleName = sStyle
	If nAligne <> com.sun.star.style.ParagraphAdjust.LEFT Then oCurseur.ParaAdjust = nAligne
	If nRetrait > 0 Then oCurseur.ParaLeftMargin = nRetrait
	If nAlinea > 0 Then oCurseur.ParaFirstLineIndent = nAlinea
	If nApres >= 0 Then oCurseur.ParaBottomMargin = nApres
	If dTaille > 0 Then oCurseur.CharHeight = dTaille
	If nEncre >= 0 Then oCurseur.CharColor = nEncre
	If sGras <> "" Then
		oCurseur.CharWeight = com.sun.star.awt.FontWeight.BOLD
		oText.insertString(oCurseur, sGras, False)
		oCurseur.setPropertyToDefault("CharWeight")
	End If
	oText.insertString(oCurseur, sTexte, False)
	oText.insertControlCharacter(oCurseur, com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
	oCurseur.setAllPropertiesToDefault()
End Sub

Private Sub Aligner(n As Integer)
	nAligne = n
End Sub

' La mise en page des paragraphes suivants : retrait à gauche et alinéa (1/100 mm), espace après (-1 : celui du style)
Private Sub Mise(nGauche As Long, nPremiere As Long, nEspace As Long)
	nRetrait = nGauche
	nAlinea = nPremiere
	nApres = nEspace
End Sub

' Les caractères des paragraphes suivants : taille (0 : celle du style), encre (-1 : celle du style)
Private Sub Caracteres(dT As Double, nE As Long)
	dTaille = dT
	nEncre = nE
End Sub

' Le début d'un document guidé : sGenre (compte-rendu, lettre, cv, attestation, annonce, devoir), et Mes informations
Function Modele(sGenre As String, sNom As String, sAdresse As String, sTelephone As String, sCourriel As String, sVille As String) As String
	Dim oDoc As Object, sDate As String, aMois As Variant, d As Date, sQui As String
	On Error GoTo Erreur
	oDoc = ThisComponent
	If Len(oDoc.Text.String) > 0 Then
		Modele = "!Ce document n'est plus vide : le modèle s'ouvre dans un document neuf"
		Exit Function
	End If
	Preparer()
	aMois = Array("janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre")
	d = Now()
	sDate = Day(d) & " " & aMois(Month(d) - 1) & " " & Year(d)
	sQui = IIf(sNom <> "", sNom, "[Votre nom]")
	If sVille = "" Then sVille = "[Ville]"
	oCurseur = oDoc.Text.createTextCursor()
	oCurseur.gotoEnd(False)
	Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
	Mise(0, 0, -1)
	Caracteres(0, -1)
	Select Case sGenre
	Case "compte-rendu"
		P("Subtitle", "Compte rendu")
		P("Title", "[Réunion, assemblée générale] du " & sDate)
		P("Subtitle", "[Association ou service] · [heure], [lieu]")
		P("Heading 1", "Présents et absents")
		P("Standard", "Présents : [noms]. Excusés : [noms]. Absents : [noms].")
		P("Heading 1", "1. [Premier point]")
		P("Standard", "[Ce qui a été présenté, ce qui a été dit.]")
		P("Heading 1", "2. [Deuxième point]")
		P("Standard", "[Ce qui a été décidé.]")
		P("Heading 1", "Prochaine réunion")
		P("Standard", "[Date], [heure], [lieu].")
	Case "lettre"
		' (la disposition des lettres officielles : l'expéditeur en haut à gauche, la date à droite, le destinataire et la
		' signature décalés vers la droite, le corps justifié avec un alinéa)
		Mise(0, 0, 0)
		PG("Sender", sQui, "")
		P("Sender", IIf(sAdresse <> "", sAdresse, "[Votre adresse]"))
		If sVille <> "[Ville]" And InStr(1, sAdresse, sVille, 1) = 0 Then P("Sender", sVille)
		Mise(0, 0, 420)
		P("Sender", IIf(sTelephone <> "", sTelephone, "[Votre téléphone]") & IIf(sCourriel <> "", " · " & sCourriel, ""))
		Aligner(com.sun.star.style.ParagraphAdjust.RIGHT)
		Mise(0, 0, 360)
		P("Standard", sVille & ", le " & sDate)
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
		Mise(8700, 0, 0)
		P("Standard", "À [Madame, Monsieur le Directeur]")
		P("Standard", "[Service, entreprise ou administration]")
		Mise(8700, 0, 480)
		P("Standard", "[Adresse du destinataire]")
		Mise(0, 0, 360)
		PG("Standard", "Objet : ", "[demande de …]")
		P("Standard", "[Madame, Monsieur le Directeur],")
		Aligner(com.sun.star.style.ParagraphAdjust.BLOCK)
		Mise(0, 1000, -1)
		P("Standard", "[Écrivez ici votre demande : ce que vous demandez, pourquoi, depuis quand.]")
		Mise(0, 1000, 480)
		P("Standard", "Je vous prie d'agréer, [Madame, Monsieur le Directeur], l'expression de mes salutations distinguées.")
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
		Mise(11300, 0, 480)
		P("Standard", sQui)
		Mise(0, 0, -1)
		Caracteres(10.5, ENCRE_DOUCE)
		P("Standard", "[Pièces jointes : …, ou rien]")
	Case "cv"
		P("Title", sQui)
		P("Subtitle", IIf(sTelephone <> "", sTelephone, "[Téléphone]") & " · " & IIf(sCourriel <> "", sCourriel, "[Courriel]") & " · " & IIf(sAdresse <> "", sAdresse, "[Ville]"))
		P("Heading 1", "Profil")
		P("Standard", "[En deux lignes : ce que vous savez faire, ce que vous cherchez.]")
		P("Heading 1", "Expérience")
		P("Heading 3", "[Poste] · [Entreprise], [années]")
		P("Standard", "[Ce que vous y avez fait, ce que vous y avez appris.]")
		P("Heading 1", "Formation")
		P("Standard", "[Diplôme], [école], [année]")
		P("Heading 1", "Compétences et langues")
		P("Standard", "[Informatique, langues parlées et écrites…]")
	Case "attestation"
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Title", "ATTESTATION DE [TRAVAIL, D'HÉBERGEMENT, DE PRÉSENCE]")
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
		P("Standard", "")
		P("Standard", "Je soussigné(e), " & sQui & ", [fonction], atteste que [Madame ou Monsieur …], né(e) le [date] à [lieu], [ce qui est attesté] depuis le [date].")
		P("Standard", "En foi de quoi, la présente attestation lui est délivrée pour servir et valoir ce que de droit.")
		P("Standard", "")
		Aligner(com.sun.star.style.ParagraphAdjust.RIGHT)
		P("Standard", "Fait à " & sVille & ", le " & sDate)
		Aligner(com.sun.star.style.ParagraphAdjust.RIGHT)
		P("Standard", sQui)
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
	Case "annonce"
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Title", "[GRAND TITRE DE L'ANNONCE]")
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Heading 1", "[Samedi 25 octobre], [16 h] · [Lieu]")
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Standard", "[Ce qui va se passer, pour qui, ce qu'il faut apporter.]")
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Standard", "Renseignements : " & IIf(sTelephone <> "", sTelephone, "[téléphone]"))
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
	Case "devoir"
		P("Standard", "[Établissement]")
		P("Standard", "[Classe] · [Matière]")
		P("Standard", "")
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Title", "[Sujet du devoir ou de l'exposé]")
		Aligner(com.sun.star.style.ParagraphAdjust.CENTER)
		P("Subtitle", "Présenté par " & sQui & " · " & sDate)
		Aligner(com.sun.star.style.ParagraphAdjust.LEFT)
		P("Heading 1", "Introduction")
		P("Standard", "[Le sujet, la question posée, le plan annoncé.]")
		P("Heading 1", "I. [Première partie]")
		P("Standard", "")
		P("Heading 1", "II. [Deuxième partie]")
		P("Standard", "")
		P("Heading 1", "Conclusion")
		P("Standard", "")
	End Select
	' (le curseur au début : le premier crochet à remplacer)
	oDoc.CurrentController.ViewCursor.gotoStart(False)
	oDoc.setModified(False)
	Modele = ""
	Exit Function
Erreur:
	Modele = "!" & Error$
End Function
' ——— La ligne du curseur (le menu « / » des blocs, « @ ») ———

' Le texte du paragraphe avant le curseur : {"avant": …, "vide": le paragraphe est vide, "tableau": dans un tableau}
Function Ligne() As String
	Dim oVC As Object, oC As Object, oP As Object, bTableau As Boolean
	On Error GoTo Erreur
	oVC = ThisComponent.CurrentController.ViewCursor
	oC = oVC.Text.createTextCursorByRange(oVC.Start)
	oC.gotoStartOfParagraph(True)
	oP = oVC.Text.createTextCursorByRange(oVC.Start)
	oP.gotoStartOfParagraph(False)
	oP.gotoEndOfParagraph(True)
	bTableau = False
	On Error Resume Next
	bTableau = Not IsNull(oVC.TextTable) And Not IsEmpty(oVC.TextTable)
	On Error GoTo Erreur
	Ligne = "{""avant"":" & Texte(oC.String) & ",""vide"":" & IIf(oP.String = "", "true", "false") & ",""tableau"":" & IIf(bTableau, "true", "false") & "}"
	Exit Function
Erreur:
	Ligne = "!" & Error$
End Function

' Efface les n caractères avant le curseur (« /tab », « @sam ») ; puis écrit sTexte s'il y en a un
Function RemplacerAvant(sLongueur As String, sTexte As String) As String
	Dim oVC As Object, oC As Object
	On Error GoTo Erreur
	oVC = ThisComponent.CurrentController.ViewCursor
	oC = oVC.Text.createTextCursorByRange(oVC.Start)
	If CLng(sLongueur) > 0 Then
		oC.goLeft(CLng(sLongueur), True)
		oC.setString("")
	End If
	If sTexte <> "" Then
		oVC.Text.insertString(oC, sTexte, False)
		oVC.gotoRange(oC.End, False)
	End If
	RemplacerAvant = ""
	Exit Function
Erreur:
	RemplacerAvant = "!" & Error$
End Function

' ——— Les blocs du menu « / » que le moteur n'a pas tout faits ———

' Un tableau de Sama : des traits clairs, la ligne des titres teintée, en gras, répétée sur chaque page
Private Sub Habiller(oTable As Object)
	Dim oBords As New com.sun.star.table.TableBorder2, oTrait As New com.sun.star.table.BorderLine2, i As Integer
	Dim oCellule As Object, oCurs As Object
	oTrait.Color = RGB(208, 200, 189)
	oTrait.LineWidth = 18
	oTrait.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
	oBords.TopLine = oTrait
	oBords.BottomLine = oTrait
	oBords.LeftLine = oTrait
	oBords.RightLine = oTrait
	oBords.HorizontalLine = oTrait
	oBords.VerticalLine = oTrait
	oBords.IsTopLineValid = True
	oBords.IsBottomLineValid = True
	oBords.IsLeftLineValid = True
	oBords.IsRightLineValid = True
	oBords.IsHorizontalLineValid = True
	oBords.IsVerticalLineValid = True
	oTable.TableBorder2 = oBords
	oTable.RepeatHeadline = True
	oTable.HeaderRowCount = 1
	For i = 0 To oTable.getColumns().getCount() - 1
		oCellule = oTable.getCellByPosition(i, 0)
		oCellule.BackColor = RGB(226, 236, 231)
		oCurs = oCellule.createTextCursor()
		oCurs.gotoEnd(True)
		oCurs.CharWeight = com.sun.star.awt.FontWeight.BOLD
	Next i
End Sub

' Un tableau (la barre d'outils, le menu « / ») : sColonnes × sLignes, à la manière de Sama
Function Tableau(sColonnes As String, sLignes As String) As String
	Dim oDoc As Object, oVC As Object, oTable As Object
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	oTable = oDoc.createInstance("com.sun.star.text.TextTable")
	oTable.initialize(CLng(sLignes), CLng(sColonnes))
	oVC.Text.insertTextContent(oVC, oTable, False)
	Habiller(oTable)
	' (le curseur dans la première case)
	oVC.gotoRange(oTable.getCellByPosition(0, 0).getStart(), False)
	Tableau = ""
	Exit Function
Erreur:
	Tableau = "!" & Error$
End Function

' La liste de présence : N°, Nom et prénom, Signature ; dix lignes (une ligne des titres teintée, répétée sur chaque page)
Function ListePresence() As String
	Dim oDoc As Object, oVC As Object, oTable As Object, aSep As Variant, i As Integer, oCellule As Object, aTitres As Variant
	Dim oCurs As Object, oRangee As Object
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	oTable = oDoc.createInstance("com.sun.star.text.TextTable")
	oTable.initialize(11, 3)
	oVC.Text.insertTextContent(oVC, oTable, False)
	aSep = oTable.TableColumnSeparators
	Dim oSep0 As Object, oSep1 As Object
	oSep0 = aSep(0)
	oSep0.Position = 900
	aSep(0) = oSep0
	oSep1 = aSep(1)
	oSep1.Position = 6000
	aSep(1) = oSep1
	oTable.TableColumnSeparators = aSep
	aTitres = Array("N°", "Nom et prénom", "Signature")
	For i = 0 To 2
		oTable.getCellByPosition(i, 0).setString(aTitres(i))
	Next i
	Habiller(oTable)
	For i = 1 To 10
		oCellule = oTable.getCellByPosition(0, i)
		oCellule.setString(CStr(i))
		oRangee = oTable.getRows().getByIndex(i)
		oRangee.IsAutoHeight = False
		oRangee.Height = 900
	Next i
	ListePresence = ""
	Exit Function
Erreur:
	ListePresence = "!" & Error$
End Function

' L'encadré « À retenir » : un style à lui (« Encadré » : un fond léger, de l'air autour ; Entrée revient au texte
' normal), mis sur le paragraphe du curseur
Function Encadre() As String
	Dim oDoc As Object, oStyles As Object, oStyle As Object, oVC As Object, oP As Object, oLigne As New com.sun.star.table.BorderLine2
	Dim nFond As Long
	On Error GoTo Erreur
	oDoc = ThisComponent
	oStyles = oDoc.StyleFamilies.getByName("ParagraphStyles")
	If Not oStyles.hasByName("Encadré") Then
		oStyle = oDoc.createInstance("com.sun.star.style.ParagraphStyle")
		oStyles.insertByName("Encadré", oStyle)
		oStyle.ParentStyle = "Standard"
		oStyle.FollowStyle = "Standard"
		nFond = RGB(236, 242, 239)
		oStyle.ParaBackColor = nFond
		' (des bords de la couleur du fond : ils donnent l'air autour du texte)
		oLigne.Color = nFond
		oLigne.LineWidth = 2
		oLigne.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
		oStyle.LeftBorder = oLigne
		oStyle.RightBorder = oLigne
		oStyle.TopBorder = oLigne
		oStyle.BottomBorder = oLigne
		oStyle.LeftBorderDistance = 300
		oStyle.RightBorderDistance = 300
		oStyle.TopBorderDistance = 200
		oStyle.BottomBorderDistance = 200
		oStyle.ParaTopMargin = 120
		oStyle.ParaBottomMargin = 240
	End If
	oVC = oDoc.CurrentController.ViewCursor
	oP = oVC.Text.createTextCursorByRange(oVC.Start)
	oP.ParaStyleName = "Encadré"
	' (« À retenir : » en gras ; l'espace qui suit ne l'est pas : la suite tapée non plus)
	oP.CharWeight = com.sun.star.awt.FontWeight.BOLD
	oVC.Text.insertString(oP, "À retenir :", False)
	oP.CharWeight = com.sun.star.awt.FontWeight.NORMAL
	oVC.Text.insertString(oP, " ", False)
	oVC.gotoRange(oP.End, False)
	Encadre = ""
	Exit Function
Erreur:
	Encadre = "!" & Error$
End Function

' La signature : décalée vers la droite ; l'image de la signature (Mes informations), sinon un espace pour signer ;
' puis le nom
Function Signature(sNom As String, sImage As String) As String
	Dim oDoc As Object, oVC As Object, oText As Object, oImage As Object, oFournisseur As Object, oGraphique As Object
	Dim aP(0) As New com.sun.star.beans.PropertyValue, oTaille As Object, oTailleImage As New com.sun.star.awt.Size
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	oText = oVC.Text
	oVC.ParaLeftMargin = 11300
	If sImage <> "" And FileExists(sImage) Then
		oFournisseur = createUnoService("com.sun.star.graphic.GraphicProvider")
		aP(0).Name = "URL"
		aP(0).Value = ConvertToURL(sImage)
		oGraphique = oFournisseur.queryGraphic(aP())
		oImage = oDoc.createInstance("com.sun.star.text.TextGraphicObject")
		oImage.Graphic = oGraphique
		oImage.AnchorType = com.sun.star.text.TextContentAnchorType.AS_CHARACTER
		' (4,5 cm de large, la hauteur à proportion)
		oTaille = oGraphique.SizePixel
		oTailleImage.Width = 4500
		oTailleImage.Height = 1500
		If oTaille.Width > 0 Then oTailleImage.Height = CLng(4500 * oTaille.Height / oTaille.Width)
		oImage.Size = oTailleImage
		oText.insertTextContent(oVC, oImage, False)
	Else
		oText.insertString(oVC, "Signature", False)
		oText.insertControlCharacter(oVC, com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
	End If
	oText.insertControlCharacter(oVC, com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
	oText.insertString(oVC, IIf(sNom <> "", sNom, "[Votre nom]"), False)
	Signature = ""
	Exit Function
Erreur:
	Signature = "!" & Error$
End Function

' ——— Un tableau de Sama Sheet, lié ———
' Le tableau est copié dans le document (Word le lit comme un tableau ordinaire) ; un signet dans sa première case le
' retrouve (« SamaSheet1 » : Word garde les signets, pas le nom des tableaux) ; d'où il vient est noté dans les
' propriétés du document (« Sama.Sheet.SamaSheet1 » : le fichier, le tableau, la date du fichier lu) : quand le
' classeur change, Sama propose de le mettre à jour. (Le classeur est lu à part, par lire-classeur.py : ce moteur, ouvert
' sur un texte, ne sait pas ouvrir un classeur à côté. Ses cases arrivent ici en une chaîne : lignes séparées par
' Chr(30), cases par Chr(31) ; sNombres : pour chaque ligne, « 0101… », 1 pour une case de nombre.)

' Le tableau du document reçoit ces cases : autant de lignes et de colonnes, les nombres à droite, les titres teintés,
' la ligne des totaux en gras
Private Sub RemplirTable(oTable As Object, sDonnees As String, sNombres As String, bTotaux As Boolean)
	Dim aLignes As Variant, aNombres As Variant, nL As Long, nC As Long, nR As Long, nK As Long, r As Long, c As Long
	Dim aL As Variant, sN As String, oCellule As Object, oCurs As Object
	' (IIf calcule ses deux branches : un If pour ce qui peut dépasser)
	aLignes = Split(sDonnees, Chr(30))
	aNombres = Split(sNombres, Chr(30))
	nL = UBound(aLignes) + 1
	aL = Split(aLignes(0), Chr(31))
	nC = UBound(aL) + 1
	nR = oTable.getRows().getCount()
	nK = oTable.getColumns().getCount()
	If nR < nL Then oTable.getRows().insertByIndex(nR, nL - nR)
	If nR > nL Then oTable.getRows().removeByIndex(nL, nR - nL)
	If nK < nC Then oTable.getColumns().insertByIndex(nK, nC - nK)
	If nK > nC Then oTable.getColumns().removeByIndex(nC, nK - nC)
	For r = 0 To nL - 1
		aL = Split(aLignes(r), Chr(31))
		sN = ""
		If r <= UBound(aNombres) Then sN = aNombres(r)
		For c = 0 To nC - 1
			oCellule = oTable.getCellByPosition(c, r)
			If c <= UBound(aL) Then oCellule.setString(aL(c)) Else oCellule.setString("")
			oCurs = oCellule.createTextCursor()
			oCurs.gotoEnd(True)
			oCurs.ParaAdjust = IIf(Mid(sN, c + 1, 1) = "1" And r > 0, com.sun.star.style.ParagraphAdjust.RIGHT, com.sun.star.style.ParagraphAdjust.LEFT)
			oCurs.CharWeight = IIf(r = nL - 1 And bTotaux And nL > 1, com.sun.star.awt.FontWeight.BOLD, com.sun.star.awt.FontWeight.NORMAL)
		Next c
	Next r
	Habiller(oTable)
End Sub

' Le signet du tableau, au début de sa première case (remis après chaque remplissage, qui efface le texte des cases)
Private Sub Marquer(oDoc As Object, oTable As Object, sCle As String)
	Dim oMarque As Object, oCase As Object
	If oDoc.Bookmarks.hasByName(sCle) Then oDoc.Bookmarks.getByName(sCle).dispose()
	oCase = oTable.getCellByPosition(0, 0)
	oMarque = oDoc.createInstance("com.sun.star.text.Bookmark")
	oMarque.Name = sCle
	oCase.insertTextContent(oCase.getStart(), oMarque, False)
End Sub

' Le tableau d'un signet (rien s'il a été supprimé)
Private Function TableDe(oDoc As Object, sCle As String) As Object
	Dim oAncre As Object
	TableDe = Nothing
	If Not oDoc.Bookmarks.hasByName(sCle) Then Exit Function
	oAncre = oDoc.Bookmarks.getByName(sCle).getAnchor()
	On Error Resume Next
	TableDe = oAncre.TextTable
End Function

Private Sub NoterLien(oDoc As Object, sTable As String, sChemin As String, sNom As String)
	Dim oProps As Object, sCle As String, sValeur As String
	oProps = oDoc.DocumentProperties.UserDefinedProperties
	sCle = "Sama.Sheet." & sTable
	sValeur = sChemin & Chr(9) & sNom & Chr(9) & FileDateTime(sChemin)
	If oProps.getPropertySetInfo().hasPropertyByName(sCle) Then
		oProps.setPropertyValue(sCle, sValeur)
	Else
		oProps.addProperty(sCle, 128, sValeur)      ' (128 : REMOVABLE)
	End If
End Sub

' Insérer au curseur le tableau sNom du classeur sChemin, d'après ses cases ; rend le nom du tableau dans le document
Function InsererDonnees(sChemin As String, sNom As String, sDonnees As String, sNombres As String, sTotaux As String) As String
	Dim oDoc As Object, oVC As Object, oTable As Object, aLignes As Variant, aL As Variant, sCle As String, n As Long
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	aLignes = Split(sDonnees, Chr(30))
	aL = Split(aLignes(0), Chr(31))
	oDoc.UndoManager.enterUndoContext("Tableau de Sheet")
	oTable = oDoc.createInstance("com.sun.star.text.TextTable")
	oTable.initialize(UBound(aLignes) + 1, UBound(aL) + 1)
	oVC.Text.insertTextContent(oVC, oTable, False)
	RemplirTable(oTable, sDonnees, sNombres, sTotaux = "true")
	n = 1
	Do While oDoc.Bookmarks.hasByName("SamaSheet" & n)
		n = n + 1
	Loop
	sCle = "SamaSheet" & n
	Marquer(oDoc, oTable, sCle)
	NoterLien(oDoc, sCle, sChemin, sNom)
	oDoc.UndoManager.leaveUndoContext()
	InsererDonnees = sCle
	Exit Function
Erreur:
	InsererDonnees = "!" & Error$
End Function

' Les tableaux liés du document : [{"table", "fichier", "nom", "change" : le classeur a changé depuis, "manque" : il
' n'est plus là}]
Function LiensSheet() As String
	Dim oDoc As Object, oProps As Object, aInfos As Variant, i As Long, s As String, sCle As String, aV As Variant
	Dim sTable As String, bManque As Boolean, bChange As Boolean
	On Error GoTo Erreur
	oDoc = ThisComponent
	oProps = oDoc.DocumentProperties.UserDefinedProperties
	aInfos = oProps.getPropertySetInfo().getProperties()
	s = ""
	For i = 0 To UBound(aInfos)
		sCle = aInfos(i).Name
		If Left(sCle, 11) = "Sama.Sheet." Then
			sTable = Mid(sCle, 12)
			aV = Split(oProps.getPropertyValue(sCle), Chr(9))
			If UBound(aV) >= 2 And Not IsNull(TableDe(oDoc, sTable)) Then
				bManque = Not FileExists(aV(0))
				bChange = False
				If Not bManque Then bChange = (FileDateTime(aV(0)) <> aV(2))
				If s <> "" Then s = s & ","
				s = s & "{""table"":" & Texte(sTable) & ",""fichier"":" & Texte(aV(0)) & ",""nom"":" & Texte(aV(1)) _
				      & ",""change"":" & IIf(bChange, "true", "false") & ",""manque"":" & IIf(bManque, "true", "false") & "}"
			End If
		End If
	Next i
	LiensSheet = "[" & s & "]"
	Exit Function
Erreur:
	LiensSheet = "!" & Error$
End Function

' Mettre à jour un tableau lié d'après les cases relues dans son classeur (un seul Ctrl+Z le défait)
Function MettreAJourDonnees(sTable As String, sDonnees As String, sNombres As String, sTotaux As String) As String
	Dim oDoc As Object, oProps As Object, aV As Variant, oTable As Object
	On Error GoTo Erreur
	oDoc = ThisComponent
	oProps = oDoc.DocumentProperties.UserDefinedProperties
	aV = Split(oProps.getPropertyValue("Sama.Sheet." & sTable), Chr(9))
	oTable = TableDe(oDoc, sTable)
	If IsNull(oTable) Then
		MettreAJourDonnees = "!Ce tableau n'est plus dans le document"
		Exit Function
	End If
	oDoc.UndoManager.enterUndoContext("Mettre à jour le tableau")
	RemplirTable(oTable, sDonnees, sNombres, sTotaux = "true")
	Marquer(oDoc, oTable, sTable)
	NoterLien(oDoc, sTable, aV(0), aV(1))
	oDoc.UndoManager.leaveUndoContext()
	MettreAJourDonnees = ""
	Exit Function
Erreur:
	MettreAJourDonnees = "!" & Error$
End Function

' ——— Les liens ———

' Le lien autour du curseur : les morceaux voisins qui mènent à la même adresse (un lien en partie en gras en a
' plusieurs) ; aDebut, aFin : ses bornes
Private Function LienAutour(oVC As Object, aBornes As Variant) As String
	Dim oText As Object, oC As Object, oEnumP As Object, oPar As Object, oEnum As Object, oPortion As Object
	Dim sAdresse As String, oDebut As Object, oFin As Object, bDedans As Boolean
	LienAutour = ""
	oText = oVC.Text
	oC = oText.createTextCursorByRange(oVC.Start)
	oC.gotoStartOfParagraph(False)
	oC.gotoEndOfParagraph(True)
	oEnumP = oC.createEnumeration()
	Do While oEnumP.hasMoreElements()
		oPar = oEnumP.nextElement()
		If oPar.supportsService("com.sun.star.text.Paragraph") Then
			oEnum = oPar.createEnumeration()
			sAdresse = ""
			Do While oEnum.hasMoreElements()
				oPortion = oEnum.nextElement()
				If oPortion.HyperLinkURL <> sAdresse Then
					' (un lien se termine : le curseur y était-il ?)
					If sAdresse <> "" And bDedans Then GoTo Trouve
					sAdresse = oPortion.HyperLinkURL
					oDebut = oPortion.Start
					bDedans = False
				End If
				oFin = oPortion.End
				If sAdresse <> "" Then
					If oText.compareRegionStarts(oPortion.Start, oVC.Start) >= 0 And oText.compareRegionStarts(oVC.Start, oPortion.End) >= 0 Then bDedans = True
				End If
			Loop
			If sAdresse <> "" And bDedans Then GoTo Trouve
		End If
	Loop
	Exit Function
Trouve:
	aBornes(0) = oDebut
	aBornes(1) = oFin
	LienAutour = sAdresse
End Function

' Le lien où est le curseur : {"adresse", "texte"} ; "" sans lien
Function Lien() As String
	Dim oVC As Object, aBornes(1) As Object, sAdresse As String, oC As Object
	On Error GoTo Erreur
	oVC = ThisComponent.CurrentController.ViewCursor
	If Not oVC.isCollapsed() Then
		Lien = ""
		Exit Function
	End If
	sAdresse = LienAutour(oVC, aBornes)
	If sAdresse = "" Then
		Lien = ""
		Exit Function
	End If
	oC = oVC.Text.createTextCursorByRange(aBornes(0))
	oC.gotoRange(aBornes(1), True)
	Lien = "{""adresse"":" & Texte(sAdresse) & ",""texte"":" & Texte(oC.String) & "}"
	Exit Function
Erreur:
	Lien = ""
End Function

' Poser un lien (sAdresse vide : le retirer) : sur le texte choisi ; sur le lien où est le curseur ; sinon l'adresse
' devient le texte du lien
Function PoserLien(sAdresse As String) As String
	Dim oDoc As Object, oVC As Object, oPlage As Object, aBornes(1) As Object, oC As Object
	On Error GoTo Erreur
	oDoc = ThisComponent
	oVC = oDoc.CurrentController.ViewCursor
	If Not oVC.isCollapsed() Then
		oPlage = oDoc.CurrentSelection.getByIndex(0)
		oPlage.HyperLinkURL = sAdresse
	ElseIf LienAutour(oVC, aBornes) <> "" Then
		oC = oVC.Text.createTextCursorByRange(aBornes(0))
		oC.gotoRange(aBornes(1), True)
		oC.HyperLinkURL = sAdresse
		If sAdresse = "" Then oC.setPropertyToDefault("CharStyleName")
	ElseIf sAdresse <> "" Then
		oC = oVC.Text.createTextCursorByRange(oVC.Start)
		oVC.Text.insertString(oC, sAdresse, True)
		oC.HyperLinkURL = sAdresse
		oVC.gotoRange(oC.End, False)
	End If
	PoserLien = ""
	Exit Function
Erreur:
	PoserLien = "!" & Error$
End Function
]]></script:module>
