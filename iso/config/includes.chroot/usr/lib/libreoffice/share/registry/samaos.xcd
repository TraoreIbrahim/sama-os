<?xml version="1.0" encoding="UTF-8"?>
<!-- Sama : Sama Docs, Sheet et Présentations gardent une copie de secours de chaque document toutes les minutes
     (au lieu de 10) : après une coupure de courant, presque rien n'est perdu (voir /usr/libexec/samaos/courant.py).
     Pas d'« Astuce du jour » à l'ouverture. Monnaie par défaut : le franc CFA (XOF, Côte d'Ivoire). Couleurs des
     graphiques : celles de Sama (forêt, ocre, bleu, latérite, vert tendre, prune, or, sarcelle, brun, rose, bleu gris,
     gris chaud), comme dans Sama Sheet. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
 <dependency file="main"/>
 <oor:component-data oor:name="Recovery" oor:package="org.openoffice.Office">
  <node oor:name="AutoSave">
   <prop oor:name="Enabled"><value>true</value></prop>
   <prop oor:name="TimeIntervall"><value>1</value></prop>
  </node>
 </oor:component-data>
 <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
   <prop oor:name="ShowTipOfTheDay"><value>false</value></prop>
  </node>
 </oor:component-data>
 <oor:component-data oor:name="Chart" oor:package="org.openoffice.Office">
  <node oor:name="DefaultColor">
   <prop oor:name="Series"><value>3107671 14259770 4091550 11883311 9286778 8085132 14926443 5151386 10251086 13208219 7244968 9077367</value></prop>
  </node>
 </oor:component-data>
 <oor:component-data oor:name="Setup" oor:package="org.openoffice">
  <node oor:name="L10N">
   <prop oor:name="ooSetupCurrency"><value>XOF-fr-CI</value></prop>
  </node>
 </oor:component-data>
</oor:data>
