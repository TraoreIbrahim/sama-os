# Paquets de l'ISO live Sama OS 0.1 (prototype)

# Bureau : KDE Plasma 6, qui sera personnalisé aux couleurs de Sama
kde-plasma-desktop
sddm
plasma-nm
plasma-pa
# Accueil du premier démarrage (Bienvenue.qml)
qml-qt6
# Fichiers, l'explorateur de Sama (liste des dossiers en QML, aperçus des PDF et des vidéos)
qml6-module-qt-labs-folderlistmodel
poppler-utils
ffmpegthumbnailer
# Lecteur vidéo et audio (provisoire, renommé « Lecteur vidéo »)
haruna
powerdevil
kscreen
bluedevil
breeze-gtk-theme

# Applications provisoires, en attendant la suite Sama
# (Griot, Sama Docs, Sama Sheet, Sugu… remplaceront ces logiciels et seront renommés)
dolphin
konsole
kate
okular
gwenview
ark
chromium
libreoffice-writer
libreoffice-calc
libreoffice-impress
# LibreOffice en Wayland natif, avec les fenêtres de Plasma (sans lui : rendu X11, parfois noir sous XWayland),
# en français, avec l'orthographe et la césure
libreoffice-kf6
libreoffice-l10n-fr
hunspell-fr
hyphen-fr
plasma-discover
plasma-discover-backend-flatpak
flatpak

# Mises à jour la nuit (samaos-mises-a-jour-nuit.timer)
unattended-upgrades
# Data consommée jour par jour, gardée d'un allumage à l'autre (carte Data, Réglages › Data)
vnstat
# Sauvegarde sur clé USB ou disque externe (Réglages › Sauvegarde)
rsync

# Installation sur disque (sera rebrandée aux couleurs de Sama)
calamares
calamares-settings-debian

# Langues, claviers et polices (Noto pour l'interface, Andika pour l'apprentissage)
locales
keyboard-configuration
fonts-noto-core
fonts-noto-ui-core
fonts-noto-mono
fonts-sil-andika

# Matériel et réseau
network-manager
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree

# Écran de démarrage (éléphant et barre de progression)
plymouth
plymouth-label

# Machines virtuelles (UTM, QEMU) : écran net qui suit la taille de la fenêtre, copier-coller
# (sans effet sur un vrai ordinateur)
spice-vdagent
qemu-guest-agent

# Système de fichiers résistant aux coupures (instantanés)
btrfs-progs

# Outils utilisés par les scripts de Sama
curl
dbus-bin
librsvg2-bin

# Réglages Sama : impression sans pilote (imprimantes réseau et USB récentes)
cups
cups-filters
ipp-usb
avahi-daemon
# Réglages Sama : VPN (OpenVPN ; WireGuard est géré par NetworkManager)
network-manager-openvpn
wireguard-tools
# Réglages Sama : accessibilité (lecteur d'écran)
orca
qt6-style-kvantum
