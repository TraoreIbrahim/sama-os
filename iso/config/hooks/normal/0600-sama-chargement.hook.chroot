#!/bin/sh
# Écran de démarrage animé de Sama OS (Plymouth).
# Les animations de la trompe sont calculées ici image par image (Plymouth ne lit pas le SVG animé) :
#   salut-N.png        : la trompe se lève puis redescend (démarrage)
#   balancement-N.png  : la trompe se balance (extinction, redémarrage)
#   trace-N.png        : la trompe se dessine en or de 0 à 100 % (mises à jour)
set -e

THEME=/usr/share/plymouth/themes/samaos
IVOIRE="#E6DAC2"
NUIT="#151A2B"
OR="#F2C879"
SOCLE="#2B3555"

# Tête et oreilles de l'éléphant (identiques sur toutes les images), avec « Sama » dessous
tete() {
	cat <<FIN
  <circle cx="25" cy="40" r="21" fill="$IVOIRE"/>
  <circle cx="75" cy="40" r="21" fill="$IVOIRE"/>
  <ellipse cx="50" cy="40" rx="19" ry="23" fill="$IVOIRE" stroke="$NUIT" stroke-width="4"/>
  <circle cx="43" cy="36" r="2.6" fill="$NUIT"/>
  <circle cx="57" cy="36" r="2.6" fill="$NUIT"/>
FIN
}

# Une image complète : $1 = contenu de la trompe (SVG), $2 = fichier PNG de sortie
image() {
	cat > /tmp/sama-image.svg <<FIN
<svg xmlns="http://www.w3.org/2000/svg" width="320" height="380" viewBox="0 0 320 380">
 <g transform="translate(60 20) scale(2)">
$(tete)
$1
 </g>
 <text x="160" y="330" text-anchor="middle" font-family="Noto Sans" font-weight="300" font-size="56" fill="$IVOIRE">Sama</text>
</svg>
FIN
	rsvg-convert --height 600 /tmp/sama-image.svg -o "$2"
}

# Trompe : $1 = chemin, $2 = couleur, $3 = attributs en plus (rotation, pointillés)
trompe() {
	echo "<path d=\"$1\" fill=\"none\" stroke=\"$2\" stroke-width=\"10\" stroke-linecap=\"round\" $3/>"
}
# Contour nuit sous la trompe, qui la détache de la tête quand elle passe devant
contour() {
	echo "<path d=\"$1\" fill=\"none\" stroke=\"$NUIT\" stroke-width=\"15\" stroke-linecap=\"round\" pathLength=\"100\" stroke-dasharray=\"84 200\" stroke-dashoffset=\"-16\" $2/>"
}

REPOS="M50 58 C50 70 63 66 63 77 C63 88 47 90 42 83"

# --- Salut : repos, montée, pause en haut, descente (48 images) -----------------
N=48
i=0
while [ $i -lt $N ]; do
	chemin=$(awk -v i=$i -v n=$N 'BEGIN {
		split("50 58 50 70 63 66 63 77 63 88 47 90 42 83", r, " ")
		split("50 58 50 68 62 70 72 64 82 58 86 50 84 44", h, " ")
		t = i / n
		if (t < 0.15) k = 0
		else if (t < 0.50) { u = (t - 0.15) / 0.35; k = (1 - cos(u * 3.14159265)) / 2 }
		else if (t < 0.65) k = 1
		else { u = (t - 0.65) / 0.35; k = (1 + cos(u * 3.14159265)) / 2 }
		for (j = 1; j <= 14; j++) p[j] = r[j] + (h[j] - r[j]) * k
		printf "M%.2f %.2f C%.2f %.2f %.2f %.2f %.2f %.2f C%.2f %.2f %.2f %.2f %.2f %.2f",
			p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[13], p[14]
	}')
	image "$(contour "$chemin")
$(trompe "$chemin" "$IVOIRE")" "$THEME/salut-$i.png"
	i=$((i + 1))
done

# --- Balancement : rotation douce autour de la base de la trompe (36 images) ------
N=36
i=0
while [ $i -lt $N ]; do
	angle=$(awk -v i=$i -v n=$N 'BEGIN { printf "%.2f", 9 * sin(2 * 3.14159265 * i / n) }')
	image "$(contour "$REPOS" "transform=\"rotate($angle 50 58)\"")
$(trompe "$REPOS" "$IVOIRE" "transform=\"rotate($angle 50 58)\"")" "$THEME/balancement-$i.png"
	i=$((i + 1))
done

# --- Tracé progressif : la trompe se dessine en or, de 0 à 100 % (41 images) ------
i=0
while [ $i -le 40 ]; do
	reste=$((100 - i * 100 / 40))
	or=$(trompe "$REPOS" "$OR" "pathLength=\"100\" stroke-dasharray=\"100\" stroke-dashoffset=\"$reste\"")
	[ $i -eq 0 ] && or=""
	image "$(contour "$REPOS")
$(trompe "$REPOS" "$SOCLE")
$or" "$THEME/trace-$i.png"
	i=$((i + 1))
done
rm -f /tmp/sama-image.svg

# Barre de progression du démarrage : fond discret et remplissage or
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="8" height="8" fill="#262B3D"/></svg>' \
	| rsvg-convert -o "$THEME/barre-fond.png"
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="8" height="8" fill="#F2C879"/></svg>' \
	| rsvg-convert -o "$THEME/barre.png"

# --- Mises à jour au redémarrage (maquette ses-05, dessinée à 1440 × 900 puis mise à l'échelle) ----------------
# Fond : les dunes de Sama sous un voile nuit
cat > /tmp/sama-maj.svg <<FIN
<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="900" viewBox="0 0 1440 900">
 <rect width="1440" height="900" fill="$NUIT"/>
 <circle cx="1030" cy="300" r="54" fill="$IVOIRE"/>
 <path d="M0 560 C 240 505, 430 520, 650 548 S 1100 498, 1440 532 L1440 900 L0 900 Z" fill="#1B2135"/>
 <path d="M0 645 C 210 605, 470 612, 710 642 S 1180 600, 1440 628 L1440 900 L0 900 Z" fill="#20273F"/>
 <path d="M0 725 C 260 692, 530 702, 770 728 S 1200 690, 1440 714 L1440 900 L0 900 Z" fill="#252E4A"/>
 <path d="M0 805 C 300 778, 610 792, 870 808 S 1260 782, 1440 798 L1440 900 L0 900 Z" fill="$SOCLE"/>
 <rect width="1440" height="900" fill="$NUIT" fill-opacity="0.85"/>
</svg>
FIN
rsvg-convert /tmp/sama-maj.svg -o "$THEME/maj-fond.png"
# L'éléphant seul (72 px dans la maquette)
cat > /tmp/sama-maj.svg <<FIN
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100">
$(tete)
 <path d="$REPOS" fill="none" stroke="$IVOIRE" stroke-width="10" stroke-linecap="round"/>
</svg>
FIN
rsvg-convert --width 288 --height 288 /tmp/sama-maj.svg -o "$THEME/maj-logo.png"
# « Ne débranchez pas l'ordinateur » (carte de 520 px, dessinée au triple)
cat > /tmp/sama-maj.svg <<'FIN'
<svg xmlns="http://www.w3.org/2000/svg" width="520" height="76" viewBox="0 0 520 76">
 <rect x="0.25" y="0.25" width="519.5" height="75.5" rx="16" fill="#FFFFFF" fill-opacity="0.05" stroke="#FFFFFF" stroke-opacity="0.08" stroke-width="0.5"/>
 <circle cx="35" cy="33" r="17" fill="#2F6B57" fill-opacity="0.4"/>
 <g transform="translate(26 24) scale(0.75)" fill="none" stroke="#A3D6C1" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 3l8 3v6c0 5-3.5 8-8 9c-4.5-1-8-4-8-9V6z M8.8 12.2l2.2 2.2l4.2-4.4"/>
 </g>
 <text x="66" y="31" font-family="Noto Sans" font-weight="500" font-size="14" fill="#F1EBE1">Ne débranchez pas l'ordinateur.</text>
 <text x="66" y="54" font-family="Noto Sans" font-size="13" fill="#ADA698">En cas de coupure, Sama reviendra automatiquement à l'état précédent.</text>
</svg>
FIN
rsvg-convert --width 1560 /tmp/sama-maj.svg -o "$THEME/maj-carte.png"
rm -f /tmp/sama-maj.svg
# Barre : piste discrète et remplissage ivoire
printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="8" height="8" fill="#FFFFFF" fill-opacity="0.1"/></svg>' \
	| rsvg-convert -o "$THEME/maj-piste.png"
printf '%s' "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"8\" height=\"8\"><rect width=\"8\" height=\"8\" fill=\"$IVOIRE\"/></svg>" \
	| rsvg-convert -o "$THEME/maj-barre.png"

# Thème par défaut (l'image de démarrage est régénérée plus tard par live-build)
plymouth-set-default-theme samaos
