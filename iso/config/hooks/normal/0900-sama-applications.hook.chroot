#!/bin/sh
# Applications QML de Sama : chacune a son propre exécutable (copie du lanceur QML de Qt) pour porter
# son identité sous Wayland (org.qt-project.<nom>), reconnue par la Natte et Alt+Tab.
set -e
mkdir -p /usr/lib/samaos/bin
cp /usr/lib/qt6/bin/qml /usr/lib/samaos/bin/samaos-reglages
cp /usr/lib/qt6/bin/qml /usr/lib/samaos/bin/samaos-fichiers
cp /usr/lib/qt6/bin/qml /usr/lib/samaos/bin/samaos-moniteur
cp /usr/lib/qt6/bin/qml /usr/lib/samaos/bin/samaos-aide
cp /usr/lib/qt6/bin/qml /usr/lib/samaos/bin/samaos-selecteur
