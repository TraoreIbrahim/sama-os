<?xml version="1.0" encoding="utf-8"?>
<!-- Un moment de la liste : sa couleur, son nom, ses heures et son lieu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/barre"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_barre" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 600"
            android:singleLine="true"
            android:textColor="@color/widget_encre"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_encre2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
