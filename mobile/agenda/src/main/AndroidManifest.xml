<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Les anniversaires des contacts, lus (jamais copiés) pour les montrer le bon jour. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Les widgets se redessinent à la minute où un moment commence ou finit (réveil qui ne réveille pas le téléphone). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:enableOnBackInvokedCallback="true" android:icon="@mipmap/ic_appli" android:label="Agenda" android:supportsRtl="true" android:theme="@style/Theme.Appli">
        <activity android:name=".Agenda" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
            <!-- « Ajouter à l'agenda » et « voir cet événement » depuis les autres applis. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
                <data android:mimeType="time/epoch" />
            </intent-filter>
        </activity>
        <!-- Les rappels : le fournisseur d'agendas d'Android prévient l'appli d'agenda, qui affiche la notification. -->
        <receiver android:name=".Rappel" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" />
            </intent-filter>
        </receiver>

        <!-- Les widgets de l'Accueil, en trois tailles (une, deux ou trois rangées). -->
        <receiver android:name=".WidgetAgendaBref" android:exported="false" android:label="@string/widget_bref">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_bref" />
        </receiver>
        <receiver android:name=".WidgetAgenda" android:exported="false" android:label="@string/widget_heures">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_heures" />
        </receiver>
        <receiver android:name=".WidgetAgendaSemaine" android:exported="false" android:label="@string/widget_semaine">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_semaine" />
        </receiver>
    </application>
</manifest>
