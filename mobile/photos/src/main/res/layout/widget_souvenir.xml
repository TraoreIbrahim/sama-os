<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget « Souvenir » (deux rangées) : une photo de ce jour, une autre année (ou une favorite), et ce qu'elle rappelle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_souvenir_fond"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 650"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:singleLine="true"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
