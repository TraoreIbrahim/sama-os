<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget « Note » (deux rangées) : la note épinglée, sinon la dernière écrite ; ses premières lignes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rubrique"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontVariationSettings="'wght' 650"
            android:singleLine="true"
            android:textColor="@color/widget_accent"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/widget_encre2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontVariationSettings="'wght' 650"
        android:singleLine="true"
        android:textColor="@color/widget_encre"
        android:textSize="16.5sp" />

    <LinearLayout
        android:id="@+id/lignes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
