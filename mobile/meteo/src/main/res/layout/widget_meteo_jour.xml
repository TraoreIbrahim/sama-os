<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne des jours qui viennent : le jour, le temps, la chance de pluie, le moins, l'écart, le plus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/jour"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true"
        android:textColor="#3A1D0F"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/icone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/pluie"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:fontVariationSettings="'wght' 600"
        android:singleLine="true"
        android:textColor="#3D5A99"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/min"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:fontVariationSettings="'wght' 400"
        android:gravity="end"
        android:singleLine="true"
        android:textColor="#7A5340"
        android:textSize="13.5sp" />

    <ImageView
        android:id="@+id/barre"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/max"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:fontVariationSettings="'wght' 600"
        android:singleLine="true"
        android:textColor="#3A1D0F"
        android:textSize="14sp" />
</LinearLayout>
