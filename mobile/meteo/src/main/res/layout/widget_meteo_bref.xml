<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget « En bref » (une rangée) : la température, la ville, le temps ou la pluie qui vient, le plus et le moins du jour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ciel_jour"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="18dp">

    <TextView
        android:id="@+id/temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontVariationSettings="'wght' 200"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#3A1D0F"
        android:textSize="42sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/epingle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/ville"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontVariationSettings="'wght' 600"
                android:singleLine="true"
                android:textColor="#3A1D0F"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 480"
            android:singleLine="true"
            android:textColor="#3A1D0F"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/bornes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 400"
            android:singleLine="true"
            android:textColor="#7A5340"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/picto"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no" />
</LinearLayout>
