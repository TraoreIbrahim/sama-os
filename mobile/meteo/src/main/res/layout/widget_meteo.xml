<?xml version="1.0" encoding="utf-8"?>
<!--
  Les widgets « Heure par heure » (deux rangées) et « Les jours qui viennent » (trois) : en haut la ville, la
  température, le temps, le plus et le moins ; dessous les prochaines heures, puis les jours (posés par le code).
  Pas de police propre : l'Accueil ouvre les widgets dans un contexte restreint, où Android ignore les polices
  des applis ; les widgets prennent celle du système (Noto Sans dans Sama OS), avec ses graisses variables.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ciel_jour"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/epingle"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ville"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontVariationSettings="'wght' 600"
                    android:singleLine="true"
                    android:textColor="#3A1D0F"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 200"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#3A1D0F"
                android:textSize="40sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/picto"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="3dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/phrase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontVariationSettings="'wght' 480"
                android:gravity="end"
                android:maxWidth="210dp"
                android:singleLine="true"
                android:textColor="#3A1D0F"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/bornes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontVariationSettings="'wght' 400"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#7A5340"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Les heures prennent la place qui reste, centrées dedans. -->
    <LinearLayout
        android:id="@+id/heures"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <FrameLayout
        android:id="@+id/trait"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="6dp"
        android:background="#1F2A2018"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/jours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
