<?xml version="1.0" encoding="utf-8"?>
<!-- Le ciel de la Météo dans un widget, de jour : le dégradé d'après-midi et la lueur en haut à droite. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#EDB98D" android:centerColor="#F3D3B2" android:endColor="#F6E3CF" android:centerY="0.45" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="260dp" android:height="260dp" android:top="-120dp" android:end="-90dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#CCFFECC8" android:endColor="#00FFECC8" />
        </shape>
    </item>
</layer-list>
