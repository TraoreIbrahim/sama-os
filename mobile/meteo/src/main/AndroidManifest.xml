<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Les prévisions d'Open-Meteo : quelques kilo-octets, à l'ouverture ou quand on actualise. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- « Près de vous » : la position approximative, arrondie encore à 10 km avant de partir. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:enableOnBackInvokedCallback="true" android:icon="@mipmap/ic_appli" android:label="Météo" android:supportsRtl="true" android:theme="@style/Theme.Appli">
        <activity android:name=".Meteo" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Les widgets de l'Accueil, en trois tailles (une, deux ou trois rangées). -->
        <receiver android:name=".WidgetMeteoBref" android:exported="false" android:label="@string/widget_bref">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_meteo_bref" />
        </receiver>
        <receiver android:name=".WidgetMeteo" android:exported="false" android:label="@string/widget_heures">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_meteo_heures" />
        </receiver>
        <receiver android:name=".WidgetMeteoSemaine" android:exported="false" android:label="@string/widget_semaine">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_meteo_semaine" />
        </receiver>

        <!-- Des prévisions fraîches pour les widgets, quand les gardées ont plus de 3 heures (6 sur les données mobiles). -->
        <service android:name=".ReleveMeteo" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Le temps qu'il fait, pour la tuile Météo du mode simplifié : réservé au système (vérifié à chaque lecture). -->
        <provider android:name=".ResumeMeteo" android:authorities="africa.samaos.meteo.maintenant" android:exported="true" />
    </application>
</manifest>
