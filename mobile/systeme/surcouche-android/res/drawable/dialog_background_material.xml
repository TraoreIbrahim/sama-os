<?xml version="1.0" encoding="utf-8"?>
<!-- Le fond des dialogues d'Android, comme à l'origine, mais à 28dp fixes, comme les dialogues de Sama : le rayon
     des dialogues (45dp) sert à arrondir la loupe du texte. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <solid android:color="?android:attr/colorBackground" />
    </shape>
</inset>
