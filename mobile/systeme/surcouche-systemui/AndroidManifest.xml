<?xml version="1.0" encoding="utf-8"?>
<!-- Les réglages de constructeur que Sama OS change dans l'interface système d'Android (SystemUI),
     posés en surcouche statique (/product/overlay). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="africa.samaos.surcouche.systemui">

    <overlay
        android:isStatic="true"
        android:priority="50"
        android:targetPackage="com.android.systemui" />

    <application android:hasCode="false" />
</manifest>
