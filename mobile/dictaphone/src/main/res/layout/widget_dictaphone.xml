<?xml version="1.0" encoding="utf-8"?>
<!--
  Le widget « Enregistrer » (une rangée) : au repos, le grand bouton et le dernier enregistrement ; pendant
  l'enregistrement, le temps qui défile (compté par Android), pause et arrêter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/bouton"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/widget_rond"
        android:padding="17dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 600"
            android:singleLine="true"
            android:textColor="@color/widget_encre"
            android:textSize="15sp" />

        <Chronometer
            android:id="@+id/chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 300"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_encre"
            android:textSize="28sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_encre2"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_rond_doux"
        android:padding="11dp"
        android:visibility="gone" />
</LinearLayout>
