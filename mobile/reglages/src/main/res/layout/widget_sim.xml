<?xml version="1.0" encoding="utf-8"?>
<!-- Une SIM : l'opérateur, le crédit en grand, la data qui reste et la fin du forfait, la barre de la data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/operateur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontVariationSettings="'wght' 600"
            android:singleLine="true"
            android:textColor="@color/widget_encre2"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontVariationSettings="'wght' 600"
        android:singleLine="true"
        android:textColor="@color/widget_encre"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_encre2"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/barre"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</LinearLayout>
